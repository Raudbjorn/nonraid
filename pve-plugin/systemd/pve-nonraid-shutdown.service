[Unit]
Description=Arm and tear down the exact PVE-owned NonRAID stack
Before=pve-guests.service
After=pve-cluster.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/pve-nonraid-lifecycle arm
ExecStop=/usr/sbin/pve-nonraid-lifecycle teardown
TimeoutStartSec=30s
TimeoutStopSec=5min
