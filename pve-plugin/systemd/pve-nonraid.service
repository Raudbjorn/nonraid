[Unit]
Description=NonRAID array teardown ordering for Proxmox VE storage
Documentation=https://github.com/Raudbjorn/nonraid
# Started by the NonRAID storage plugin on first activation; ExecStart is a
# no-op. The unit exists so node shutdown tears the stack down in order
# (guests -> mergerfs pools -> member mounts -> array) - hence only ExecStop
# does real work. Do not enable it; the plugin starts it on demand.
Requires=local-fs.target
After=local-fs.target
Before=pve-guests.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Unmount every mergerfs pool the plugin created (fsname=nonraid-<storeid>).
# Storage ids cannot contain whitespace, so cutting field 2 is safe here.
ExecStop=-/bin/sh -c 'grep "^nonraid-.* fuse.mergerfs " /proc/mounts | cut -d" " -f2 | xargs -r -n1 umount'
ExecStop=-/usr/bin/nmdctl -u unmount
ExecStop=-/usr/bin/nmdctl -u stop
ExecStop=-/bin/rm -f /var/lib/nonraid/array.running
