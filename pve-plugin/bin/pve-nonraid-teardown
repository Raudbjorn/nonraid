#!/bin/sh
# Ordered teardown of the NonRAID storage stack, run as pve-nonraid.service's
# ExecStop after pve-guests has stopped the guests: mergerfs pools, then the
# member mounts, then the array itself.
#
# Every pool is attempted even if an earlier one failed - one unmountable pool
# must not strand the others - but the layers BELOW the pools are only touched
# once every pool is known to be gone. mergerfs pins the member mounts it
# unions, so asking nmdctl to detach them under a live pool is asking for a
# refusal at best; and if the mount table could not be read, there is no basis
# for believing no pool is left.
#
# /var/lib/nonraid/array.running is removed only if the whole teardown
# succeeded. That file is the unclean-shutdown marker: leaving it behind makes
# the next activation run a correcting parity check, which is the right call
# when the array was not brought down cleanly.
#
# Exits 0 regardless, so a busy pool cannot turn shutdown into a failed job;
# what went wrong is on stderr and in the journal.
set -u

MOUNTS="${PVE_NONRAID_MOUNTS:-/proc/mounts}"
NMDCTL="${PVE_NONRAID_NMDCTL:-/usr/bin/nmdctl}"
MARKER="${PVE_NONRAID_MARKER:-/var/lib/nonraid/array.running}"
# Each external command is bounded on its own. systemd's stop timeout kills the
# whole ExecStop, so one wedged umount would take every later pool and layer
# with it; a per-step bound keeps the rest of the teardown reachable and leaves
# systemd's timeout as the looser backstop.
STEP_TIMEOUT="${PVE_NONRAID_STEP_TIMEOUT:-60}"

ok=1
pools_known=0

# Pools are identified by the fsname the plugin always sets
# (nonraid-<storeid>), never by path. Field 2 is the mountpoint, which is the
# operator-set storage path and so may contain whitespace - the kernel escapes
# that as \040, which printf %b turns back into a space.
#
# Deepest first, so a pool nested under another is removed before its parent;
# taking /proc/mounts order would hit the parent first, get EBUSY, and never
# come back to it. Reverse byte order puts '/srv/a/b' ahead of '/srv/a'.
#
# A read failure here is NOT "no pools". Conflating the two is how a degraded
# system talks itself into removing the unclean-shutdown marker without ever
# having looked at the mount table.
# awk and sort are deliberately not one pipeline: a pipeline reports the LAST
# command's status, so an awk that could not open the file would be masked by
# a sort that happily succeeds on empty input - exactly the failure this
# check exists to catch.
if raw=$(awk '$1 ~ /^nonraid-/ && $3 == "fuse.mergerfs" { print $2 }' "$MOUNTS" 2>/dev/null); then
    # The sort is checked too. Treating a failed sort as "no pools" would hand
    # partial or empty output to the loop below as if it were the whole truth,
    # which is the same fail-open the awk check exists to prevent.
    if pools=$(printf '%s\n' "$raw" | LC_ALL=C sort -r); then
        pools_known=1
    else
        echo "pve-nonraid: could not order the pool list; treating the mount" \
            "table as unread" >&2
        ok=0
    fi
else
    echo "pve-nonraid: cannot read the mount table ($MOUNTS); mounted pools" \
        "cannot be ruled out, so nothing below them is torn down" >&2
    ok=0
fi

if [ "$pools_known" = 1 ] && [ -n "$pools" ]; then
    # A while-read loop, not 'for': an unquoted expansion is still subject to
    # pathname expansion, and /proc/mounts escapes whitespace but not '*', '?'
    # or bracket patterns, so a mountpoint containing those would expand to
    # unrelated local paths.
    while IFS= read -r escaped; do
        [ -n "$escaped" ] || continue
        mp=$(printf '%b' "$escaped")
        if timeout "$STEP_TIMEOUT" umount "$mp" 2>/dev/null; then
            echo "pve-nonraid: unmounted pool $mp"
        else
            echo "pve-nonraid: could not unmount pool $mp" >&2
            ok=0
        fi
    done <<EOF
$pools
EOF
fi

# Members and the array come down only once no pool is known to be holding
# them. mergerfs pins every branch it unions, so nmdctl would be asked to
# detach devices that are busy; and if the pool list could not be read at all,
# "busy" cannot be established. Fail closed and leave the stack up - the marker
# stays, and the next activation runs the correcting check.
if [ "$ok" = 1 ]; then
    # 'stop' only after 'unmount' succeeded. Stopping the array while a member
    # filesystem is still mounted pulls the block device out from under a live
    # filesystem - the very thing this ordered teardown exists to prevent - so
    # a failed unmount has to stop the sequence rather than be noted and
    # stepped over.
    if timeout "$STEP_TIMEOUT" "$NMDCTL" -u unmount >/dev/null 2>&1; then
        if ! timeout "$STEP_TIMEOUT" "$NMDCTL" -u stop >/dev/null 2>&1; then
            echo "pve-nonraid: nmdctl stop failed" >&2
            ok=0
        fi
    else
        echo "pve-nonraid: nmdctl unmount failed; not stopping the array while" \
            "a member may still be mounted" >&2
        ok=0
    fi
else
    echo "pve-nonraid: a pool is still mounted or unaccounted for;" \
        "skipping member unmount and array stop" >&2
fi

if [ "$ok" = 1 ]; then
    rm -f "$MARKER"
else
    echo "pve-nonraid: teardown incomplete, keeping $MARKER so the next" \
        "activation re-checks parity" >&2
fi

exit 0
