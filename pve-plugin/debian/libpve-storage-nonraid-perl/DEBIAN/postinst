#!/bin/sh
set -e

# configure: fresh install/upgrade of this package.
# triggered: another package (pve-manager) replaced index.html.tpl.
# The GUI injection is cosmetic - never fail the dpkg run over it.
case "$1" in
    configure)
        /usr/share/pve-nonraid/pve-nonraid-gui apply || true
        for s in pve-cluster pvedaemon pvestatd pveproxy pvescheduler; do
            systemctl try-restart "$s.service" >/dev/null 2>&1 || true
        done
        ;;
    triggered)
        /usr/share/pve-nonraid/pve-nonraid-gui apply || true
        ;;
esac

# Automatically added by dh_installsystemd/14.3
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'pve-nonraid.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'pve-nonraid.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'pve-nonraid.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'pve-nonraid.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'pve-nonraid.service' >/dev/null || true
fi
# End automatically added section

