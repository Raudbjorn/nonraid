#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright 2026 Sveinbjörn Geirsson

set -eu

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo "usage: $0 <libpve-storage-nonraid-perl.deb>" >&2
    exit 2
fi

manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT HUP INT TERM
dpkg-deb --fsys-tarfile "$1" | tar -tf - >"$manifest"

expected_paths='
./usr/share/perl5/PVE/Storage/Custom/NonRAIDPlugin.pm
./usr/lib/systemd/system/pve-nonraid-boot.service
./usr/lib/systemd/system/pve-nonraid-shutdown.service
./usr/lib/systemd/system/pve-guests.service.d/20-pve-nonraid.conf
./usr/share/doc/libpve-storage-nonraid-perl/changelog.Debian.gz
./usr/share/doc/libpve-storage-nonraid-perl/copyright
'

printf '%s\n' "$expected_paths" | while IFS= read -r path; do
    [ -n "$path" ] || continue
    count=$(grep -Fxc -- "$path" "$manifest" || :)
    if [ "$count" -ne 1 ]; then
        echo "$path: expected exactly once in $1, found $count" >&2
        exit 1
    fi
done

file_count=$(grep -vc '/$' "$manifest" || :)
if [ "$file_count" -ne 6 ]; then
    echo "$1: expected exactly six planned payload files, found $file_count" >&2
    exit 1
fi
