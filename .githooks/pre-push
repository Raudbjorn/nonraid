#!/bin/sh
# The gate every push passes through. GitHub Actions is DELIBERATELY DISABLED
# on this fork, so the checks under checks/ are the CI, and this hook is what
# runs them. Tiered the way the workflows' paths: filters were:
#
#   fast tier    always                      (~12s: lint + unit suites)
#   package tier pve-plugin/** or tools/**  (docker: build all three debs)
#   PVE tier     pve-plugin/** or tools/**  (docker: apt install + load + lifecycle)
#
# The heavy tiers run in a prebuilt image (first run builds it, ~5 min; after
# that tens of seconds). Escapes, in order of preference:
#   NONRAID_PUSH_FAST=1 git push   - fast tier only, says so loudly
#   git push --no-verify           - no gate at all, for emergencies
#
# Install (once per clone): git config core.hooksPath .githooks
set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# What is being pushed? pre-push gets "<local ref> <local sha> <remote ref>
# <remote sha>" per ref on stdin. Collect the union of changed paths; a
# deleted remote ref or an up-to-date one contributes nothing.
zero=0000000000000000000000000000000000000000
changed=""
run_all=0
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue    # deleting a remote ref
    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch: diff against where it forked from main, falling
        # back to everything reachable if there is no main to compare with.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null \
            || git merge-base "$local_sha" fork/main 2>/dev/null) || base=""
    else
        base="$remote_sha"
    fi
    if [ -n "$base" ]; then
        changed="$changed
$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"
    else
        # Its own flag, NOT a sentinel value in $changed: a later ref in the
        # same push would append its file list after the sentinel and the
        # exact-match test would silently stop matching - precisely for the
        # ref whose files were never enumerated.
        run_all=1
    fi
done

touches() {
    [ "$run_all" = 1 ] && return 0
    echo "$changed" | grep -qE "$1"
}

echo "pre-push: fast tier"
sh checks/fast.sh || {
    echo "pre-push: the fast tier failed; nothing was pushed." >&2
    exit 1
}

if [ "${NONRAID_PUSH_FAST:-0}" = 1 ]; then
    echo "pre-push: NONRAID_PUSH_FAST=1 - SKIPPING the package and PVE tiers." >&2
    echo "  This push is gated by lint and unit tests only." >&2
    exit 0
fi

if touches '^(pve-plugin/|tools/|debian/|dkms\.conf|Makefile)'; then
    echo "pre-push: package tier (docker)"
    sh checks/debs.sh || {
        echo "pre-push: the package tier failed; nothing was pushed." >&2
        exit 1
    }
fi

if touches '^(pve-plugin/|tools/)'; then
    echo "pre-push: PVE tier (docker)"
    sh checks/pve-load.sh || {
        echo "pre-push: the PVE tier failed; nothing was pushed." >&2
        exit 1
    }
fi

echo "pre-push: gate passed"
exit 0
