#!/bin/sh
# Local gate, run before every push. GitHub Actions has never executed on this
# fork, so this hook is the only thing standing between a broken tree and the
# remote - it runs the same checks the workflows declare.
#
# Bypass for an emergency push: git push --no-verify
# Install (once per clone):    git config core.hooksPath .githooks
set -u

here=$(git rev-parse --show-toplevel)
cd "$here" || exit 1

fail=0
step() {
    name="$1"; shift
    printf '>>> %s ... ' "$name"
    if out=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAIL"
        printf '%s\n' "$out" | tail -20
        fail=1
    fi
}

# A missing tool fails the push rather than skipping the check: this hook
# replaces CI, and a skipped check that reports nothing reads as a pass.
for tool in shellcheck perl prove bats node; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "pre-push: '$tool' is not installed; the gate cannot run." >&2
        echo "  Install it, or bypass deliberately with: git push --no-verify" >&2
        exit 1
    }
done

step "shellcheck nmdctl"      shellcheck -x tools/nmdctl
step "shellcheck plugin bins" shellcheck -x pve-plugin/bin/pve-nonraid-gui pve-plugin/bin/pve-nonraid-teardown
step "shellcheck maintainer"  shellcheck -x pve-plugin/debian/postinst pve-plugin/debian/prerm pve-plugin/debian/postrm
step "shellcheck harness"     shellcheck -x test/lib.sh test/setup_disk.sh test/teardown_disk.sh test/mk_array.sh
step "bash -n nmdctl"         bash -n tools/nmdctl
step "node --check GUI js"    node --check pve-plugin/js/pve-nonraid-storage.js
step "perl syntax (stubbed)"  perl -c -I pve-plugin/t/lib -I pve-plugin pve-plugin/PVE/Storage/Custom/NonRAIDPlugin.pm
step "prove pve-plugin/t"     prove -q pve-plugin/t/
step "tpl-roundtrip"          sh pve-plugin/t/tpl-roundtrip.sh
step "teardown"               sh pve-plugin/t/teardown.sh

# The bats suite is the slowest step (~10s); it still belongs here, because
# nmdctl is where the real-world risk lives.
step "bats tools/tests"       sh -c 'cd tools && bats tests/'

if [ "$fail" -ne 0 ]; then
    echo
    echo "pre-push: the gate failed; nothing was pushed." >&2
    echo "  Fix the failures above, or bypass deliberately: git push --no-verify" >&2
    exit 1
fi
exit 0
