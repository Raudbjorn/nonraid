#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-2.0-only
export DH_VERBOSE=1

%:
	dh $@ --parallel

execute_after_dh_install:
	install -D -m 0600 systemd/nonraid.default \
		debian/nonraid-tools/etc/default/nonraid

override_dh_installsystemd:
	dh_installsystemd --name=nonraid --no-stop-on-upgrade --no-start --no-enable
	dh_installsystemd --name=nonraid-parity-check --no-stop-on-upgrade --no-start --no-enable
	dh_installsystemd --name=nonraid-notify --no-stop-on-upgrade --no-start --no-enable

override_dh_installudev:
	dh_installudev --name=nonraid --priority=90

execute_after_dh_fixperms:
	chmod 600 debian/nonraid-tools/etc/default/nonraid

execute_after_dh_builddeb:
	debian/check-package-manifest ../nonraid-tools_1.23.0-1_all.deb
