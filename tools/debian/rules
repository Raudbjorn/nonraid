#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-2.0-only
export DH_VERBOSE=1

# The changelog is the package version and nmdctl's VERSION= is the tool
# version; CI and the plugin's runtime check both read the latter. Refusing a
# mismatch here is what keeps "the package version means something" true - the
# 1.0.0-1 changelog this file shipped with for a year is how a plugin
# dependency bound became unsatisfiable by the package built from its own tree.
CHANGELOG_VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')
NMDCTL_VERSION := $(shell sed -n 's/^VERSION="\?\([0-9.]*\)"\?/\1/p' nmdctl | head -1)
ifneq ($(CHANGELOG_VERSION),$(NMDCTL_VERSION))
$(error debian/changelog says $(CHANGELOG_VERSION) but tools/nmdctl VERSION= says $(NMDCTL_VERSION); run: dch -v $(NMDCTL_VERSION)-1)
endif

%:
	dh $@ --parallel

execute_after_dh_install:
	install -D -m 0600 systemd/nonraid.default \
		debian/nonraid-tools/etc/default/nonraid

# Skipped ENTIRELY, not merely defanged with --no-enable --no-start
# --no-stop-on-upgrade: those flags suppress the enable/start/stop snippets
# but dh_installsystemd still emits postinst/postrm daemon-reload autoscripts
# guarded only on `[ -d /run/systemd/system ]` - the BUILD HOST's systemd,
# with no DPKG_ROOT test. A `dpkg --root` install or removal of this package
# would reload the host's systemd on behalf of a target tree it never
# touched. The five unit files are installed by debian/install instead; the
# reloads are hand-written and DPKG_ROOT-guarded in postinst/postrm. Nothing
# is enabled/started/stopped at install/remove either way, matching the old
# --no-enable --no-start --no-stop-on-upgrade semantics exactly.
override_dh_installsystemd:

override_dh_installudev:
	dh_installudev --name=nonraid --priority=90

execute_after_dh_fixperms:
	chmod 600 debian/nonraid-tools/etc/default/nonraid

execute_after_dh_builddeb:
	debian/check-package-manifest \
		../nonraid-tools_$(shell dpkg-parsechangelog -SVersion)_all.deb
